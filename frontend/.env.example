# ========================================
# 心动小屋 · 环境变量模板
# ========================================
# 使用方式：把这个文件复制成 .env.local，然后填入真实值。
# .env.local 不会进 git（.gitignore 已经排除）。
# ========================================

# -------- 主 LLM · 豆包 / 火山方舟 --------
# 获取方式见 README。控制台：https://console.volcengine.com/ark/
# 密钥格式：以字母数字组合，约 40+ 字符
ARK_API_KEY=

# 你在火山方舟控制台创建的"接入点 ID"（Endpoint ID）
# 格式：ep-YYYYMMDDHHMMSS-xxxxx 或 ep-xxxxxxxxx
# 一个 endpoint 绑一个具体模型（例如 Doubao-Seed-1.6）
ARK_ENDPOINT_ID=

# API 域名（一般不需要改）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# -------- 备用 LLM · DeepSeek（可选） --------
# 用作 fallback 或成本更低的场景
# 获取方式：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# -------- 运行环境 --------
# 是否启用 LLM 调用（关闭时回退到硬编码剧本）
# true 开启 · false 关闭（省钱调试用）
VITE_ENABLE_LLM=false

# 用哪个 provider（ark | deepseek）
LLM_PROVIDER=ark
